{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imagineqira.com/schemas/egc2-paired-analysis-input.v0.1.schema.json",
  "title": "EGC 2.0 Paired Analysis Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "analysis_plan_id", "source_export_digest_sha256", "condition_order", "locked_for_analysis", "analysis_locked_at_utc", "records", "analysis_input_digest_sha256"],
  "properties": {
    "schema_version": {"const": "egc2-paired-analysis-input-0.1.0"},
    "study_id": {"type": "string", "minLength": 1},
    "analysis_plan_id": {"type": "string", "minLength": 1},
    "source_export_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "condition_order": {"const": ["A", "B"]},
    "locked_for_analysis": {"const": true},
    "analysis_locked_at_utc": {"type": "string", "format": "date-time"},
    "analysis_input_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participant_id", "condition", "adequacy_disposition", "retained_score", "source_record_digest_sha256", "adequacy_decision_digest_sha256", "decision_version", "decision_locked_at_utc", "record_digest_sha256"],
        "properties": {
          "participant_id": {"type": "string", "minLength": 1},
          "condition": {"enum": ["A", "B"]},
          "adequacy_disposition": {"enum": ["retain_numeric_score", "suppress_numeric_score_reference_inadequate", "blind_adjudication_required", "indeterminate_insufficient_review"]},
          "retained_score": {"type": ["number", "null"], "minimum": 1, "maximum": 7},
          "source_record_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "adequacy_decision_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "decision_version": {"type": "string", "minLength": 1},
          "decision_locked_at_utc": {"type": "string", "format": "date-time"},
          "record_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
